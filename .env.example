# Postgres connection string (Neon, installed via the Vercel Marketplace, sets this automatically).
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Vercel Blob read/write token (optional PDF/figure attachments).
BLOB_READ_WRITE_TOKEN=

# Auth.js secret: generate with `npx auth secret` or `openssl rand -base64 32`.
AUTH_SECRET=
# GitHub OAuth app for admin login.
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
# Comma-separated list of emails allowed to log into /admin.
ADMIN_EMAILS=admin@example.com

# Shared secret Vercel Cron sends as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=

# Public origin used in agent instructions and links, no trailing slash.
PUBLIC_BASE_URL=http://localhost:3000

# Secret pepper for HMAC-SHA256 hashing of agent API keys. Never change once keys exist.
API_KEY_PEPPER=
